# Firebase Configuration
# Obtenha essas credenciais em: Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloud Functions URL
# Após fazer deploy das functions, você verá a URL no console do Firebase
# Formato: https://[REGION]-[PROJECT_ID].cloudfunctions.net
# Exemplo: https://us-central1-meu-projeto.cloudfunctions.net
VITE_FUNCTIONS_URL=https://us-central1-your_project_id.cloudfunctions.net
